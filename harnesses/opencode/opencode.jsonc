{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "permission": "allow"
}
